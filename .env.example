# PORT OUTSIDE CONTAINER
EXTERNAL_PORT_NGINX=8000
EXTERNAL_PORT_DB=3336
EXTERNAL_PORT_REDIS=6379
EXTERNAL_PORT_RABBITMQ_ADMIN=15672
EXTERNAL_PORT_RABBITMQ=5672

APP_NAME=laravelapp
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_EXTERNAL_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=admin
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 0 - production / 1 - development
OPCACHE_VALIDATE_TIMESTAMPS=1
OPCACHE_MAX_ACCELERATED_FILES=10000
OPCACHE_MEMORY_CONSUMPTION=192
OPCACHE_MAX_WASTED_PERCENTAGE=10

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=secret
RABBITMQ_EXCHANGE=default

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

BYPASS_USER_ENABLED=false
BYPASS_USER_NAME="Bypass User"
BYPASS_USER_EMAIL="bypass@local.test"

GITHUBAI_API_KEY=
GITHUBAI_ENDPOINT=https://models.github.ai/inference
GITHUBAI_TIMEOUT=600
LLM_PRIMARY_MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

LLM_RETRY_ENABLED=true
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=60
LLM_RETRY_MAX_DELAY=300
LLM_RETRY_BACKOFF_MULTIPLIER=2.0
LLM_RESPECT_RETRY_AFTER=true

LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN=300

LLM_QUOTA_CHECK_ENABLED=true
LLM_QUOTA_BUFFER_PERCENTAGE=20
LLM_QUOTA_WARNING_THRESHOLD=80

LLM_LOAD_BALANCING=priority_fallback
LLM_PREFER_MINI_MODELS=false
LLM_ENABLE_FALLBACK=true

ORTOOLS_SOLVER_ENDPOINT=http://ortools-api:8001/solve
ORTOOLS_SOLVER_TIMEOUT=60
